        { "name": "lantern_lit", "data": { "lantern_id": "L1" }, "tick": 231 }
      ],
      "end": { "state": "playing", "score": 150 }
    }
  },
  {
    "name": "pulse_stuns_shade",
    "requirement": "Tỏa sáng xua Bóng Mực, tốn ánh sáng (PRD-0 §1-2)",
    "seed": 1, "ticks": 180,
    "scenario": { "random_motes": false, "random_shades": false, "motes": [], "player": { "carried": 2 }, "shades": [ { "id": "S1", "pos": [6, 0, 0] } ] },
    "inputs": { "frames": [ { "tick": 0, "pulse": true }, { "tick": 1, "pulse": false } ] },
    "expect": {
      "events": [ { "name": "pulse", "data": { "stunned_ids": ["S1"] }, "tick": 1 } ],
      "no_events": ["player_hit"],
      "end": { "state": "playing", "score": 20 }
    }
  },
  {
